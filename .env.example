# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=1234567890:AAH_your_bot_token_from_botfather
# Секрет для защиты вебхука и разовой ссылки /api/setup?secret=...
WEBHOOK_SECRET=change_me_to_any_random_secret_word
# Дополнительные ID админов через запятую (5188800998 уже вшит по умолчанию)
ADMIN_IDS=5188800998

# === Turso Database (SQLite over HTTP) ===
# Можно вставлять как libsql://..., так и https://...
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSI...

# === Roblox Open Cloud (нужен для сканера в GitHub Actions) ===
# Бесплатный ключ с https://create.roblox.com/dashboard/credentials (права на чтение ассетов)
ROBLOX_API_KEY=your_roblox_open_cloud_api_key
START_ASSET_ID=17500000000
TARGET_IDS_PER_RUN=150000
